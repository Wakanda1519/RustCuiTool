{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the RustCuiTool main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir"
  ]
}
